# ==============================================================================
# CHOSENWAN ENVIRONMENT VARIABLES
# ==============================================================================
# Salin file ini menjadi `.env.local` di root proyek dan isi kredensial yang sesuai.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE: TURSO (libSQL / Edge SQLite)
# ------------------------------------------------------------------------------
# Mode Lokal: Biarkan bernilai "file:chosenwan.db" untuk testing offline.
# Mode Cloud: Dapatkan URL dan Auth Token dari Dashboard Turso (https://turso.tech)
#              atau lewat terminal CLI:
#              - turso db create chosenwan
#              - turso db show chosenwan --url
#              - turso db tokens create chosenwan
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL="file:chosenwan.db"
TURSO_AUTH_TOKEN=""

# ------------------------------------------------------------------------------
# 2. AUTENTIKASI: SESSION SECRET / JWT SECRET
# ------------------------------------------------------------------------------
# Kunci acak (minimal 32 karakter) untuk mengenkripsi cookie sesi HTTP-only pengguna.
# Anda bisa menggunakan nama SESSION_SECRET atau JWT_SECRET.
# Anda bisa membuat string acak misalnya menggunakan perintah:
# openssl rand -base64 32
# ------------------------------------------------------------------------------
SESSION_SECRET="ganti-dengan-kunci-rahasia-minimal-32-karakter-acak-anda!"
JWT_SECRET=""

# ------------------------------------------------------------------------------
# 3. MEDIA STORAGE: IMAGEKIT.IO (Upload & CDN Poster)
# ------------------------------------------------------------------------------
# Dapatkan ketiga nilai ini dari Dashboard ImageKit.io (https://imagekit.io)
# Menu: Developer Options -> API Keys
# Forever Free: 3 GB storage, 20 GB bandwidth/bulan (tanpa kartu kredit).
# ------------------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
